# ══════════════════════════════════════════════════════════════════════════════
# VTT Template - Root .gitignore
# Sub-projects have their own .gitignore for specific ignores
# ══════════════════════════════════════════════════════════════════════════════

# ═══ OS ═══
.DS_Store
Thumbs.db
Desktop.ini
._*

# ═══ IDEs ═══
.idea/
*.swp
*.swo
*~

# ═══ Environment ═══
.env
.env.local
.env.*.local
!.env.example

# ═══ Secrets ═══
*.pem
*.key
*credentials*.json
google-play-key.json
upload-keystore.jks
*.keystore
*.jks

# ═══ Fastlane ═══
**/fastlane/report.xml
**/fastlane/Preview.html
**/fastlane/screenshots/**/*.png
**/fastlane/test_output

# ═══ Ruby (Fastlane) ═══
Gemfile.lock
vendor/bundle/

# ═══ Logs ═══
*.log

# ═══ Generated test projects (from test_init.ps1) ═══
/test_*/
/generated/

# ═══ Personal / Non-template content ═══
/_projects_example/
