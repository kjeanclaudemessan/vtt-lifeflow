#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════
# LifeFlow — Git Pre-commit Hook
# ═══════════════════════════════════════════════════════════════════════
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# Or run: scripts/install-hooks.ps1
# ═══════════════════════════════════════════════════════════════════════

echo "🔍 Running pre-commit checks..."

FAILED=0

# ── Flutter checks ───────────────────────────────────────────────────
if git diff --cached --name-only | grep -q "^flutter/"; then
    echo "\n📱 Flutter checks..."
    
    cd flutter
    
    # Format check
    echo "  → dart format..."
    dart format --set-exit-if-changed lib/ test/ 2>/dev/null
    if [ $? -ne 0 ]; then
        echo "  ❌ Dart format issues found. Run: dart format lib/ test/"
        FAILED=1
    fi
    
    # Analyze
    echo "  → dart analyze..."
    dart analyze --fatal-infos 2>/dev/null
    if [ $? -ne 0 ]; then
        echo "  ❌ Dart analysis issues found."
        FAILED=1
    fi
    
    cd ..
fi

# ── FastAPI checks ───────────────────────────────────────────────────
if git diff --cached --name-only | grep -q "^fastapi/"; then
    echo "\n🐍 FastAPI checks..."
    
    cd fastapi
    
    # Ruff lint
    echo "  → ruff check..."
    ruff check app/ 2>/dev/null
    if [ $? -ne 0 ]; then
        echo "  ❌ Ruff lint issues found. Run: ruff check --fix app/"
        FAILED=1
    fi
    
    # Ruff format
    echo "  → ruff format..."
    ruff format --check app/ 2>/dev/null
    if [ $? -ne 0 ]; then
        echo "  ❌ Ruff format issues found. Run: ruff format app/"
        FAILED=1
    fi
    
    cd ..
fi

# ── Secrets check ────────────────────────────────────────────────────
echo "\n🔐 Checking for secrets..."
if git diff --cached --diff-filter=ACM | grep -iE "(password|secret|api_key|token)\s*[:=]\s*['\"][^'\"]{8,}" | grep -v "example\|template\|placeholder\|change-me\|xxx\|eyJ"; then
    echo "  ⚠️  Potential secret detected in staged files!"
    FAILED=1
fi

# ── Result ───────────────────────────────────────────────────────────
if [ $FAILED -ne 0 ]; then
    echo "\n❌ Pre-commit checks failed. Fix issues and try again."
    echo "   To skip: git commit --no-verify"
    exit 1
fi

echo "\n✅ All pre-commit checks passed!"
exit 0
