# ══════════════════════════════════════════════════════════════════════════════
# VTT FastAPI Template - Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ══════════════════════════════════════════════════════════════════════════════
# APP SETTINGS
# ══════════════════════════════════════════════════════════════════════════════
APP_NAME="VTT FastAPI"
APP_ENV=development  # development, staging, production
DEBUG=true
API_V1_PREFIX=/api/v1

# ══════════════════════════════════════════════════════════════════════════════
# SUPABASE
# ══════════════════════════════════════════════════════════════════════════════
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# JWT Secret (same as Supabase JWT secret for verification)
JWT_SECRET=your-supabase-jwt-secret
JWT_ALGORITHM=HS256

# ══════════════════════════════════════════════════════════════════════════════
# REDIS (optional)
# ══════════════════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379/0

# ══════════════════════════════════════════════════════════════════════════════
# EMAIL SERVICE (optional)
# ══════════════════════════════════════════════════════════════════════════════
# Resend
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com

# ══════════════════════════════════════════════════════════════════════════════
# SMS SERVICE (optional)
# ══════════════════════════════════════════════════════════════════════════════
# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ══════════════════════════════════════════════════════════════════════════════
# PUSH NOTIFICATIONS (optional)
# ══════════════════════════════════════════════════════════════════════════════
# Firebase
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# ══════════════════════════════════════════════════════════════════════════════
# PAYMENT PROVIDERS (optional)
# ══════════════════════════════════════════════════════════════════════════════
# Moneroo
MONEROO_API_KEY=your-moneroo-api-key
MONEROO_WEBHOOK_SECRET=your-webhook-secret

# Stripe
STRIPE_API_KEY=sk_test_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# ══════════════════════════════════════════════════════════════════════════════
# AI SERVICES (optional - for features)
# ══════════════════════════════════════════════════════════════════════════════
OPENAI_API_KEY=sk-xxxx
ANTHROPIC_API_KEY=sk-ant-xxxx

# ══════════════════════════════════════════════════════════════════════════════
# CORS
# ══════════════════════════════════════════════════════════════════════════════
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ══════════════════════════════════════════════════════════════════════════════
# AI AGENT MODULE (optional)
# ══════════════════════════════════════════════════════════════════════════════
AI_AGENT_ENABLED=false
AI_AGENT_DEFAULT_MODEL=gpt-4o
AI_AGENT_MAX_TOOL_ITERATIONS=10

# Chatwoot integration
CHATWOOT_API_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=your-chatwoot-token
CHATWOOT_WEBHOOK_SECRET=your-webhook-secret

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-key

# ══════════════════════════════════════════════════════════════════════════════
# CHAT PLATFORM MODULE (CPaaS)
# ══════════════════════════════════════════════════════════════════════════════
CHAT_PLATFORM_ENABLED=false
CHAT_PLATFORM_WEBHOOK_TIMEOUT=10
CHAT_PLATFORM_WEBHOOK_MAX_RETRIES=3
CHAT_PLATFORM_WEBHOOK_RETRY_DELAY=60
CHAT_PLATFORM_MESSAGE_MAX_WIDGETS=10
CHAT_PLATFORM_DEFAULT_PLAN=free
