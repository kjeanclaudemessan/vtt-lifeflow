# ============================================
# LifeFlow Flutter — Environment Variables
# ============================================
#
# Copy this file to .env.dev, .env.staging, or .env.prod
# and fill in your actual values.
#
# Usage with flutter run:
#   flutter run --dart-define-from-file=.env.staging
#
# Usage with build:
#   flutter build apk --dart-define-from-file=.env.staging
#
# ============================================

# Environment (dev | staging | production)
ENV=staging

# -----------------------------
# Supabase Configuration
# -----------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------
# PostHog (Analytics + Error Tracking)
# -----------------------------
# Leave empty to disable
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------
# Google OAuth Web Client ID
# -----------------------------
# From Google Cloud Console → Identifiants
# Used by Supabase for Google Sign-In redirect validation
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
