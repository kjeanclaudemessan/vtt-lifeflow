# ============================================
# VTT Flutter Template - Environment Variables
# ============================================
#
# Copy this file to .env.dev, .env.staging, or .env.prod
# and fill in your actual values.
#
# Usage with flutter run:
#   flutter run --dart-define-from-file=.env.dev
#
# Usage with build:
#   flutter build apk --dart-define-from-file=.env.prod
#
# ============================================

# -----------------------------
# API Configuration
# -----------------------------
API_BASE_URL=https://api.example.com/v1

# -----------------------------
# Supabase Configuration
# -----------------------------
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------
# Sentry Configuration (Error Reporting)
# -----------------------------
# Get your DSN from: https://sentry.io/settings/YOUR_ORG/projects/YOUR_PROJECT/keys/
# Leave empty to disable Sentry
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ============================================
# Firebase Configuration
# ============================================
#
# Firebase requires a separate configuration file.
# Run the following command to generate it:
#
#   dart pub global activate flutterfire_cli
#   flutterfire configure
#
# This will create lib/firebase_options.dart
# See: https://firebase.google.com/docs/flutter/setup
#
# ============================================

# ============================================
# Platform-Specific Setup
# ============================================
#
# Android:
# - Add google-services.json to android/app/
# - Configure in android/app/build.gradle.kts
#
# iOS:
# - Add GoogleService-Info.plist to ios/Runner/
# - Configure in Xcode
#
# ============================================
